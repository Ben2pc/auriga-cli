{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|PowerShell|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-ready-guard.mjs\""
          },
          {
            "type": "command",
            "timeout": 30,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-merge-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Shell|PowerShell|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-create-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch|StrReplace|Delete|EditNotebook|search_replace",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-reminder.mjs\""
          }
        ]
      }
    ]
  }
}
