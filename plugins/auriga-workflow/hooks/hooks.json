{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr ready)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-ready-guard.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(gh pr create)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-ready-guard.mjs\""
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-merge-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-create-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-reminder.mjs\""
          }
        ]
      }
    ]
  }
}
