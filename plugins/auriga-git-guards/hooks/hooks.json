{
  "description": "auriga git guards: commit-reminder (PostToolUse on Edit/Write/MultiEdit), pr-create-guard (PostToolUse on `gh pr create`), pr-ready-guard (PreToolUse on `gh pr ready`).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr ready)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-ready-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-create-guard.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/commit-reminder.mjs\""
          }
        ]
      }
    ]
  }
}
